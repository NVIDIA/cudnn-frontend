    "add_norm_quant": {"what": "residual add + RMSNorm + quantise", "origin": "cuDNN Frontend", "relation": "target", "kind": "port"},
    "fp8_projection": {"what": "8-bit in-projection of a layer", "origin": "cuDNN Frontend", "relation": "target", "kind": "port"},
    "gdn_decode_fused": {"what": "fused linear-attention decode step", "origin": "cuDNN Frontend", "relation": "target", "kind": "code", "entry": "cudnn.GdnDecodeFused", "form": {"PDL": true, "PDL_RELEASE": true}},
    "cublaslt_fp8_gemm": {"what": "8-bit out-projection of a layer", "origin": "cuBLASLt through FlashInfer", "relation": "target", "kind": "code", "selection": "the library's tuner chooses the kernel: a pick is recorded and never gated, so no launch shape is held here"},
    "attention_prepare": {"what": "attention preparation: norm, rotary embedding, cache insert", "origin": "Triton", "relation": "target", "kind": "code"},
    "fi_decode_attention": {"what": "attention core over a paged cache", "origin": "FlashInfer", "relation": "target", "kind": "code"},
    "gate_quant": {"what": "attention output gate + 8-bit quantise", "origin": "cuDNN Frontend", "relation": "target", "kind": "port", "entry": "cudnn.AttentionGateQuantDecode", "form": {"THREADS": 256, "PDL_RELEASE": true}},
    "swiglu_fp4": {"what": "MLP gate / up multiply with SiLU x up and the 4-bit quantise", "origin": "cuDNN Frontend", "relation": "target", "kind": "port"},
    "fi_mm_fp4": {"what": "4-bit multiply: MLP down, output head", "origin": "FlashInfer", "relation": "target", "kind": "code"},
    "fi_fp4_quantize": {"what": "4-bit quantise of the final hidden rows in front of the output head", "origin": "FlashInfer", "relation": "stand-in"}
  },
